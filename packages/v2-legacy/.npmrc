
# pnpm 默认使用 isolated 模式（通过软链接管理依赖），这种模式下 node_modules 里的包并不是真实的文件副本。
# 项目中使用了 bundledDependencies，npm/pnpm 需要把真实的依赖文件打包进你的发布包里。
node-linker=hoisted

# public-hoist-pattern[]=vue-eslint-parser
# public-hoist-pattern[]=@stylistic/eslint-plugin   # 不要开启，否则会导致 eslint-plugin-html 失效
public-hoist-pattern[]=@html-eslint/eslint-plugin
public-hoist-pattern[]=@html-eslint/parser
public-hoist-pattern[]=eslint-plugin-html
